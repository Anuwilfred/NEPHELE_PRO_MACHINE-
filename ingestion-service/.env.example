# --- Corvina Cloud connection --------------------------------------------
# These endpoint shapes were confirmed by watching Corvina's own web app
# (exorin.app.corvina.io) talk to its backend -- see corvinaClient.js for
# exactly what's confirmed vs. still assumed.

CORVINA_API_BASE_URL=https://app.corvina.io
CORVINA_API_KEY=REPLACE_ME

# Corvina uses two different org identifiers in different places -- both
# are needed. Find both the way this project did: open your browser's
# DevTools Network tab while using Corvina, and look at any /svc/... request.
CORVINA_ORG_ID=REPLACE_ME_NUMERIC_ORG_ID
CORVINA_ORG_RESOURCE_ID=REPLACE_ME_LIKE_yourcompany.technologyventure

# --- Polling ---------------------------------------------------------------
POLL_INTERVAL_MS=5000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://vessel:vessel@db:5432/vessel_dashboard
