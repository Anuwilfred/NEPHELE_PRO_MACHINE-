DATABASE_URL=postgres://vessel:vessel@db:5432/vessel_dashboard
PORT=3000

# --- First admin account ----------------------------------------------------
# Only used the very first time the app starts with an empty users table --
# creates one admin account so there's a way to log in and invite everyone
# else. Safe to leave in place after that; it's ignored once any user exists.
ADMIN_EMAIL=REPLACE_ME@example.com
ADMIN_PASSWORD=REPLACE_ME_WITH_A_REAL_PASSWORD

# --- Invite emails (optional) ------------------------------------------------
# Lets "Send invite" actually email the person instead of just handing the
# admin a link to share by hand. Uses a Google/Gmail account's SMTP with an
# "App Password" (Google Account -> Security -> 2-Step Verification must be
# on -> App passwords -> generate one for "Mail"). Free, no card, and the
# app password can be revoked anytime without touching the real password.
# Leave both blank to skip email -- invites still work, "Send invite" just
# shows the link to copy/share manually.
SMTP_USER=
SMTP_APP_PASSWORD=

# The address people's invite links should point at. Set this to whatever
# address reaches this server from outside (your dynamic DNS name, e.g.
# https://vessel-torq.duckdns.org) once that's set up -- until then it's
# fine to leave blank, invite links just use whatever address the admin's
# own browser is on when they click "Send invite".
PUBLIC_URL=

# Set to "true" once this sits behind HTTPS (e.g. a Cloudflare Tunnel or a
# reverse proxy with a real certificate). Leave "false" while running over
# plain http, or login cookies won't be sent back by the browser at all.
COOKIE_SECURE=false
